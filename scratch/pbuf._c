// https://godbolt.org/z/bePcrTMsq

#include <stdlib.h>
#include <stdio.h>
#include <string.h>

typedef struct pbuf_node {
	struct pbuf_node *next;
	char *str_ptr;
	unsigned long long str_len;
} pbuf_node_t;

void pbuf_print(pbuf_node_t *node) {
	for (int i = 0; i < node->str_len; i++) {
		printf("%c", node->str_ptr[i]);
	}
	if (node->next != NULL) {
		pbuf_print(node->next);
	} else {
		printf("\n");
	}
}

void *pbuf;
void *pbuf_write_head = NULL;
pbuf_node_t *pbuf_logical_last_node = NULL;
//pbuf_node_t *pbuf_first_node = NULL;

